SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=your-github-login
ADMIN_GITHUB_USERS=your-github-login
AWS_REGION=us-east-1
FERRY_PREFIX=ferry
DATA_DIR=../.data
