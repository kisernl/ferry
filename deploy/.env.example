# Copy to .env next to docker-compose.yml and fill in.
PUBLIC_URL=https://ferry.myapp.com
SESSION_SECRET= # openssl rand -hex 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS= # comma-separated logins, and/or
ALLOWED_GITHUB_ORG=   # org whose members may sign in
ADMIN_GITHUB_USERS=   # comma-separated admin logins
AWS_REGION=us-east-1
FERRY_PREFIX=ferry
# KMS_KEY_ID=arn:aws:kms:...   (optional customer-managed key)
# PROTECTED_ENVS=production
# AWS_ACCESS_KEY_ID=           (only without an IAM role)
# AWS_SECRET_ACCESS_KEY=
